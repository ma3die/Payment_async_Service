# DB constants
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# APP constants
ENVIRONMENT=local
OPENAPI_URL=/openapi.json
LOGGER_LEVEL=DEBUG
BASE_URL=http://127.0.0.1:8001
BASE_API_URL=http://127.0.0.1:8001/api/v1
TIMEZONE=Europe/Moscow
RUN_BASE_PORT=8001
RUN_BASE_HOST=127.0.0.1

APP_NAME=APP_NAME

# Auth
API_KEY=dev-api-key

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=payment
RABBITMQ_PASSWORD=payment
RABBITMQ_VHOST=/
PAYMENTS_EXCHANGE=payments
PAYMENTS_DLX=payments.dlx
PAYMENTS_QUEUE=payments.new
PAYMENTS_DLQ=payments.new.dlq
PAYMENTS_ROUTING_KEY=payments.new

# Processing
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT_SECONDS=5
OUTBOX_POLL_INTERVAL_SECONDS=1
